APP_NAME="Turath Cars"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Set to true behind HTTPS in production (also turns on HSTS)
APP_FORCE_HTTPS=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=turath
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# Public contact details shown on the website
BROKER_NAME="Turath Cars"
BROKER_EMAIL=info@turath-cars.example
BROKER_PHONE="+20 100 000 0000"
# Digits only, with country code (used for the WhatsApp button)
BROKER_WHATSAPP=201000000000

# Admin account created by `php artisan db:seed` (password: 12+ characters)
ADMIN_NAME="Turath Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=
